NODE_ENV=production
PORT=3010

MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/padel-proactive-db

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false

WHATSAPP_QUEUE_NAME=whatsapp-commands
WORKER_CONCURRENCY=2

WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_STALE_MS=30000

# NO fijar PUPPETEER_EXECUTABLE_PATH: el chromium del sistema (v144) causa el
# hang del "ready" en whatsapp-web.js (issue #127084). Se usa el Chrome bundled
# de Puppeteer que instala el Dockerfile.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WA_AUTH_DATA_PATH=/usr/src/app/.wwebjs_auth
# NO pinnear WA_REMOTE_HTML: wa-version elimina builds viejos -> el HTML 404 ->
# whatsapp-web.js nunca completa la inyeccion de Store y el "ready" nunca llega.
# Usar el frontend por defecto (el que trae la rama main de whatsapp-web.js).
# WA_REMOTE_HTML=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.2412.54.html

# Si querés forwardear mensajes entrantes al backend
BACKEND_INTERNAL_URL=
BACKEND_INTERNAL_TOKEN=
